# Official sources checked on 2026-11-09: https://www.dissco.eu/dissco/ and https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/dissco/
# The description is an English synthesis of these sources.
# Logo source checked on 2026-11-09: https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/dissco/ (colour PNG logo, legible on a light background).
rireg:dissco
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "Distributed System of Scientific Collections"@en ;
    dcterms:alternative "DiSSCo"@en ;
    foaf:homepage <https://www.dissco.eu/> ;
    foaf:depiction <https://ri-portfolio.esfri.eu/media/zw4hdnx5/logo-1.png> ;
    # Scientific domains selected from EuroSciVoc; labels: biological sciences; geology.
    # Curatorial classification based on the official scope, checked on 2026-11-09: https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/dissco/
    dcterms:subject <http://data.europa.eu/8mn/euroscivoc/803cff73-504b-41ae-9873-1836c76c15d1>, <http://data.europa.eu/8mn/euroscivoc/65f1cb53-0694-477b-9900-61ac8ad78c67> ;
    dcterms:description "A distributed European research infrastructure bringing together natural science collections held by museums, botanical gardens and universities. It aims to unify access to physical specimens and their digital representations through shared digitisation, curation and data services. By linking collection information with specimen-derived data and supporting FAIR principles, it enables research on biodiversity and geodiversity and their responses to environmental change."@en .

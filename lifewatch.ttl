# Official sources checked on 2026-11-01: https://www.lifewatch.eu/who-we-are/ and https://www.lifewatch.eu/science/
# The description is an English synthesis of these sources.
# Logo source checked on 2026-11-01: https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/lifewatch-eric/ (colour PNG/JPEG logo, legible on a light background).
rireg:lifewatch
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "e-Science and Technology European Infrastructure for Biodiversity and Ecosystem Research"@en ;
    dcterms:alternative "LifeWatch"@en, "LifeWatch ERIC"@en ;
    foaf:homepage <https://www.lifewatch.eu/> ;
    foaf:depiction <https://ri-portfolio.esfri.eu/media/y5rhi3dt/logo-1.png> ;
    # Scientific domains selected from EuroSciVoc; labels: ecology; ecosystems.
    # Classification based on the official scope, checked on 2026-11-07: https://www.lifewatch.eu/science/
    dcterms:subject <http://data.europa.eu/8mn/euroscivoc/36734fd7-bed0-4ac6-9445-a35869e83091>, <http://data.europa.eu/8mn/euroscivoc/81f1f477-aa96-427a-adf9-7742a429899a> ;
    dcterms:description "A European digital research infrastructure supporting the study of biodiversity and ecosystem functions and services. It brings together data resources, computational tools, analytical workflows and virtual research environments to enable reproducible analyses of biodiversity patterns, environmental change and ecosystem responses, supporting scientific research and evidence-based decision-making."@en .

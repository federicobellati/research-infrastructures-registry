# Full name: https://elter-ri.eu/storage/app/uploads/public/651/682/c99/651682c99f116401056824.pdf
# The description is an English synthesis of these sources.
# Logo source checked on 2026-11-01: https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/elter-ri/ (colour eLTER RI JPEG logo, legible on a light background).
rireg:elter
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "Integrated European Long-Term Ecosystem, critical zone and socio-ecological Research Infrastructure"@en ;
    dcterms:alternative "eLTER"@en, "eLTER RI"@en ;
    foaf:homepage <https://www.elter-ri.eu/> ;
    foaf:depiction <https://ri-portfolio.esfri.eu/media/clzl11yb/logo.jpg> ;
    # Scientific domains selected from EuroSciVoc; labels: ecology; environmental sciences.
    # Classification based on the official scope, checked on 2026-11-07: https://elter-ri.eu/what-are-elters-scope-and-goals
    dcterms:subject <http://data.europa.eu/8mn/euroscivoc/36734fd7-bed0-4ac6-9445-a35869e83091>, <http://data.europa.eu/8mn/euroscivoc/8e469a25-b5fd-4bf3-8cc1-d14800e650e0> ;
    dcterms:description "A distributed European research infrastructure for long-term ecosystem, critical zone and socio-ecological research. Its whole-system approach combines observations across environmental and social domains to investigate ecosystem change, supporting integrated research through sites, platforms, harmonised data, services and training."@en .

# Official sources checked on 2026-11-09: https://www.eurofleets.eu/
# The description is an English synthesis of these sources and describes the current alliance, not the completed EUROFLEETS+ project.
# Logo source checked on 2026-11-09: https://www.eurofleets.eu/ (blue PNG logo in the website header, legible on a light background).
rireg:eurofleets
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "Eurofleets"@en ;
    foaf:homepage <https://www.eurofleets.eu/> ;
    foaf:depiction <https://www.eurofleets.eu/assets/eurofleets-blue.png> ;
    # Scientific domains selected from EuroSciVoc; labels: oceanography.
    # Curatorial classification based on the official scope, checked on 2026-11-09: https://www.eurofleets.eu/
    dcterms:subject <http://data.europa.eu/8mn/euroscivoc/b0edf9eb-127a-41bc-b0cf-eb3ed9039f0c> ;
    dcterms:description "A European alliance of marine research infrastructures promoting cooperation among institutional owners and operators of research vessels. It brings together research fleets and associated marine equipment, including remotely operated and autonomous underwater vehicles, to improve access to facilities and support multidisciplinary ocean research, observation and innovation for the scientific and industrial communities."@en .

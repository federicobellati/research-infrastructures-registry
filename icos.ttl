# The description is an English synthesis of these sources.
# Logo source checked on 2026-11-01: https://www.icos-cp.eu/materials/logos-templates (regular RGB PNG logo, legible on a light background).
rireg:icos
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "Integrated Carbon Observation System"@en ;
    dcterms:alternative "ICOS"@en ;
    foaf:homepage <https://www.icos-cp.eu/> ;
    foaf:depiction <https://www.icos-cp.eu/sites/default/files/2020-04/ICOS%20RI_logo_rgb.png> ;
    dcterms:description "A distributed European research infrastructure providing standardised, high-quality and open observations of atmospheric greenhouse gas concentrations and carbon fluxes between the atmosphere, land and oceans. Its atmosphere, ecosystem and ocean measurements support research on the carbon cycle and climate change."@en .

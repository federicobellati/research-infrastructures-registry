# The description is an English synthesis of these sources.
# Logo source checked on 2026-11-01: https://ri-portfolio.esfri.eu/ri-portfolio/portfolio-editions/2024-first-edition/catalogue/euro-argo-eric/ (colour PNG/JPEG logo, legible on a light background).
rireg:euro-argo
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "European contribution to the international Argo Programme"@en ;
    dcterms:alternative "Euro-Argo"@en, "Euro-Argo ERIC"@en ;
    foaf:homepage <https://www.euro-argo.eu/> ;
    foaf:depiction <https://ri-portfolio.esfri.eu/media/z4oefwqc/logo.png> ;
    dcterms:description "A distributed research infrastructure coordinating European participation in the international Argo programme. It supports the deployment and operation of autonomous profiling floats and the delivery of openly accessible, quality-controlled ocean observations, including temperature, salinity and biogeochemical measurements, for climate research, ocean health assessment and operational oceanography."@en .

rireg:danubius-ri
    rdf:type lupo:ResearchInfrastructure ;
    dcterms:title "International Centre for Advanced Studies on River-Sea Systems"@en ;
    dcterms:alternative "DANUBIUS-RI"@en ;
    foaf:homepage <https://danubius-ri.eu/> ;
